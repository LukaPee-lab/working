<Window x:Class="NexusEditor.NexusHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Editor"
        Width="960"
        Height="620"
        MinWidth="760"
        MinHeight="500"
        WindowState="Maximized"
        Icon="Assets/AppIcon.ico"
        Background="#1b1b1b"
        Foreground="#d8d8d8"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#1b1b1b"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#242424"/>
        <SolidColorBrush x:Key="CardBackground" Color="#2b2b2b"/>
        <SolidColorBrush x:Key="CardHoverBackground" Color="#353535"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#4a4a4a"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#58a6e7"/>
        <SolidColorBrush x:Key="ReadyBrush" Color="#55c58a"/>
        <SolidColorBrush x:Key="UnavailableBrush" Color="#8b8b8b"/>

        <Style x:Key="WorkspaceCardButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Foreground" Value="#ededed"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="26"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource CardHoverBackground}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#727272"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#202020"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#252525"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#373737"/>
                                <Setter Property="Foreground" Value="#777777"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#f1f1f1"/>
        </Style>
        <Style x:Key="CardDescription" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,9,0,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#bdbdbd"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#cfcfcf"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBackground}"
                BorderBrush="#111111"
                BorderThickness="0,0,0,1"
                Padding="36,28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"
                       Width="66"
                       Height="66"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Source="Assets/AppIcon.png"
                       Stretch="Uniform"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Nexus Editor"
                               FontSize="34"
                               FontWeight="SemiBold"
                               Foreground="#f4f4f4"/>
                    <TextBlock Text="작업할 워크스페이스를 선택하세요."
                               Margin="1,5,0,0"
                               FontSize="15"
                               Foreground="#a8a8a8"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="36,34,36,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="EventCardButton"
                    Grid.Column="0"
                    Style="{StaticResource WorkspaceCardButton}"
                    Click="EventCardButton_Click">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Width="54"
                            Height="54"
                            HorizontalAlignment="Left"
                            Background="#283f55"
                            BorderBrush="#477ba7"
                            BorderThickness="1"
                            CornerRadius="3">
                        <TextBlock Text="E"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#83c4f2"/>
                    </Border>
                    <TextBlock Grid.Row="1"
                               Margin="0,20,0,0"
                               Text="Event Editor"
                               Style="{StaticResource CardTitle}"/>
                    <TextBlock Grid.Row="2"
                               Text="차원 탐사 이벤트의 장면, 선택지, 보상과 전투 흐름을 편집합니다."
                               Style="{StaticResource CardDescription}"/>
                    <Border Grid.Row="3"
                            Margin="0,24,0,0"
                            Padding="12,10"
                            Background="#202020"
                            BorderBrush="#3f3f3f"
                            BorderThickness="1"
                            CornerRadius="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="EventStatusIndicator"
                                     Width="9"
                                     Height="9"
                                     Margin="0,0,9,0"
                                     Fill="{StaticResource ReadyBrush}"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="EventStatusText"
                                       Grid.Column="1"
                                       Style="{StaticResource StatusText}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Button>

            <Button x:Name="ResearchCardButton"
                    Grid.Column="2"
                    Style="{StaticResource WorkspaceCardButton}"
                    Click="ResearchCardButton_Click">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Width="54"
                            Height="54"
                            HorizontalAlignment="Left"
                            Background="#3b3930"
                            BorderBrush="#77705a"
                            BorderThickness="1"
                            CornerRadius="3">
                        <TextBlock Text="R"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#dfcc80"/>
                    </Border>
                    <TextBlock Grid.Row="1"
                               Margin="0,20,0,0"
                               Text="Research Editor"
                               Style="{StaticResource CardTitle}"/>
                    <TextBlock Grid.Row="2"
                               Text="연구 카테고리, 연구 노드와 선행 연결을 시각적으로 편집합니다."
                               Style="{StaticResource CardDescription}"/>
                    <Border Grid.Row="3"
                            Margin="0,24,0,0"
                            Padding="12,10"
                            Background="#202020"
                            BorderBrush="#3f3f3f"
                            BorderThickness="1"
                            CornerRadius="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="ResearchStatusIndicator"
                                     Width="9"
                                     Height="9"
                                     Margin="0,0,9,0"
                                     Fill="{StaticResource ReadyBrush}"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="ResearchStatusText"
                                       Grid.Column="1"
                                       Style="{StaticResource StatusText}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Button>
        </Grid>

        <Border Grid.Row="2"
                Background="#202020"
                BorderBrush="#111111"
                BorderThickness="0,1,0,0"
                Padding="36,12">
            <TextBlock Text="DB 경로가 준비되지 않은 워크스페이스도 선택한 뒤 경로를 지정할 수 있습니다."
                       FontSize="12"
                       Foreground="#8f8f8f"/>
        </Border>
    </Grid>
</Window>

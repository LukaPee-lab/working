<Window x:Class="NexusEditor.ResearchEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Editor - Research" Width="1600" Height="960"
        MinWidth="1180" MinHeight="720" WindowState="Maximized"
        Background="#1e1e1e" Foreground="#dddddd"
        Icon="Assets/AppIcon.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#242424"/>
        <SolidColorBrush x:Key="ControlBackground" Color="#303030"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#454545"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4aa8ff"/>
        <SolidColorBrush x:Key="SelectedBrush" Color="#2f566f"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#dddddd"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#eeeeee"/>
            <Setter Property="Background" Value="#1d1d1d"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#376d92"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#eeeeee"/>
            <Setter Property="Background" Value="#383838"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                    <Setter Property="BorderBrush" Value="#666666"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.42"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#eeeeee"/>
            <Setter Property="Background" Value="#303030"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="#dddddd"/>
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#dddddd"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#343434"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2f566f"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="Foreground" Value="#dddddd"/>
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#dddddd"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#343434"/>
            <Setter Property="Foreground" Value="#dddddd"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#dddddd"/>
            <Setter Property="Background" Value="#343434"/>
            <Setter Property="Padding" Value="9,3"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="BorderBrush" Value="#111111"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="9,0"/>
        </Style>
        <Style x:Key="PanelTabCloseButton" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="MinHeight" Value="16"/>
            <Setter Property="Margin" Value="8,0,7,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="Close panel"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#b8b8b8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <Grid Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M 3,3 L 9,9 M 9,3 L 3,9" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4a4a4a"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#686868"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#252525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="Background" Value="#303030"/>
            <Setter Property="BorderBrush" Value="#505050"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#315b75"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#5faee3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#4a4a4a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="22"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Height="22" VerticalAlignment="Top">
            <MenuItem Header="Preference" Click="PreferenceMenuItem_Click"/>
            <MenuItem Header="Window">
                <MenuItem Header="Event Editor" Click="EventEditorMenuItem_Click"/>
                <MenuItem Header="Research Editor" IsCheckable="True" IsChecked="True" IsEnabled="False"/>
                <Separator/>
                <MenuItem x:Name="CategoryPaneMenuItem" Header="Category List" IsCheckable="True" IsChecked="True" Tag="category" Click="PaneMenuItem_Click"/>
                <MenuItem x:Name="ScenePaneMenuItem" Header="Scene" IsCheckable="True" IsChecked="True" Tag="scene" Click="PaneMenuItem_Click"/>
                <MenuItem x:Name="HierarchyPaneMenuItem" Header="Hierarchy" IsCheckable="True" IsChecked="True" Tag="hierarchy" Click="PaneMenuItem_Click"/>
                <MenuItem x:Name="InspectorPaneMenuItem" Header="Inspector" IsCheckable="True" IsChecked="True" Tag="inspector" Click="PaneMenuItem_Click"/>
                <MenuItem x:Name="ConsolePaneMenuItem" Header="Console" IsCheckable="True" IsChecked="True" Tag="console" Click="PaneMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem Header="Validate Research" Click="ValidateMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="#292929" BorderBrush="#111111" BorderThickness="0,0,0,1">
            <Grid Margin="7,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Reload" Margin="0,0,5,0" Click="ReloadButton_Click"/>
                <Button Grid.Column="1" Content="Fit All" Margin="0,0,5,0" Click="FitAllButton_Click"/>
                <Button Grid.Column="2" Content="Export Preview" Click="ExportPreviewButton_Click"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Permission" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="#aaaaaa"/>
                    <RadioButton x:Name="PermissionAll" GroupName="Permission" Content="All" Style="{StaticResource FilterToggle}" IsChecked="True" Tag="0" Checked="PermissionFilter_Checked"/>
                    <RadioButton GroupName="Permission" Content="1" Style="{StaticResource FilterToggle}" Tag="1" Checked="PermissionFilter_Checked"/>
                    <RadioButton GroupName="Permission" Content="2" Style="{StaticResource FilterToggle}" Tag="2" Checked="PermissionFilter_Checked"/>
                    <RadioButton GroupName="Permission" Content="3" Style="{StaticResource FilterToggle}" Tag="3" Checked="PermissionFilter_Checked"/>
                    <RadioButton GroupName="Permission" Content="4" Style="{StaticResource FilterToggle}" Tag="4" Checked="PermissionFilter_Checked"/>
                    <RadioButton GroupName="Permission" Content="5" Style="{StaticResource FilterToggle}" Tag="5" Checked="PermissionFilter_Checked"/>
                </StackPanel>
                <TextBlock x:Name="WorkbookPathText" Grid.Column="5" Margin="14,0" VerticalAlignment="Center"
                           Foreground="#9e9e9e" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DirtyText" Grid.Column="6" VerticalAlignment="Center" Foreground="#f0c75e" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CategoryColumn" Width="250" MinWidth="170"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition x:Name="RightColumn" Width="620" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="CategoryPane" Grid.Column="0" Background="{StaticResource PanelBackground}">
                <DockPanel>
                    <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                        <Grid>
                            <TextBlock Text="Category List" Style="{StaticResource PanelTitle}"/>
                            <Button Style="{StaticResource PanelTabCloseButton}" HorizontalAlignment="Right" Tag="category" Click="ClosePaneButton_Click"/>
                        </Grid>
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Margin="8">
                        <TextBox x:Name="CategorySearchBox" Height="28" Margin="0,0,0,7" TextChanged="CategorySearchBox_TextChanged" ToolTip="Search category"/>
                        <Button Content="Add Category" Click="AddCategoryButton_Click"/>
                    </StackPanel>
                    <ListBox x:Name="CategoryList" SelectionChanged="CategoryList_SelectionChanged" PreviewMouseRightButtonDown="CategoryList_PreviewMouseRightButtonDown"/>
                </DockPanel>
            </Border>
            <GridSplitter x:Name="CategorySplitter" Grid.Column="1" Width="5" Background="#111111" ResizeDirection="Columns" DragCompleted="LayoutSplitter_DragCompleted"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="ConsoleSplitterRow" Height="7"/>
                    <RowDefinition x:Name="ConsoleRow" Height="160" MinHeight="72"/>
                </Grid.RowDefinitions>
                <Border x:Name="ScenePane" Grid.Row="0" Background="#191919" BorderBrush="#111111" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                            <Grid>
                                <TextBlock Text="Scene" Style="{StaticResource PanelTitle}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="SceneStatusText" Margin="0,0,2,0" VerticalAlignment="Center" Foreground="#9e9e9e"/>
                                    <Button Style="{StaticResource PanelTabCloseButton}" Tag="scene" Click="ClosePaneButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid x:Name="SceneViewport" ClipToBounds="True" Focusable="True"
                              MouseWheel="SceneViewport_MouseWheel"
                              MouseRightButtonDown="SceneViewport_MouseRightButtonDown"
                              MouseRightButtonUp="SceneViewport_MouseRightButtonUp"
                              MouseMove="SceneViewport_MouseMove"
                              MouseLeftButtonDown="SceneViewport_MouseLeftButtonDown"
                              MouseLeftButtonUp="SceneViewport_MouseLeftButtonUp">
                            <Grid.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#1b1b1b">
                                            <GeometryDrawing.Pen><Pen Brush="#2d2d2d" Thickness="1"/></GeometryDrawing.Pen>
                                            <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,24,24"/></GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Grid.Background>
                            <Canvas x:Name="GraphCanvas" Width="22400" Height="1120" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="GraphScale" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="GraphTranslate"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>
                                <Canvas x:Name="BandCanvas" Width="22400" Height="1120" IsHitTestVisible="False"/>
                                <Canvas x:Name="LinkCanvas" Width="22400" Height="1120" Background="Transparent"/>
                                <Canvas x:Name="NodeCanvas" Width="22400" Height="1120"/>
                            </Canvas>
                        </Grid>
                    </DockPanel>
                </Border>
                <GridSplitter x:Name="ConsoleSplitter" Grid.Row="1" Height="7" Background="#3a3a3a" ResizeDirection="Rows" DragCompleted="LayoutSplitter_DragCompleted"/>
                <Border x:Name="ConsolePane" Grid.Row="2" Background="#202020">
                    <DockPanel>
                        <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                            <Grid>
                                <TextBlock Text="Console / Validation" Style="{StaticResource PanelTitle}"/>
                                <Button Style="{StaticResource PanelTabCloseButton}" HorizontalAlignment="Right" Tag="console" Click="ClosePaneButton_Click"/>
                            </Grid>
                        </Border>
                        <DockPanel DockPanel.Dock="Top" Height="32" Background="#292929">
                            <Button Content="Clear" Width="58" Height="24" Margin="7,4" Click="ClearConsoleButton_Click"/>
                            <TextBox x:Name="ConsoleSearchBox" Height="24" Margin="4" TextChanged="ConsoleSearchBox_TextChanged"/>
                        </DockPanel>
                        <ListBox x:Name="ConsoleList" MouseDoubleClick="ConsoleList_MouseDoubleClick"/>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" Background="#111111" ResizeDirection="Columns" DragCompleted="LayoutSplitter_DragCompleted"/>
            <Grid x:Name="RightPane" Grid.Column="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HierarchyColumn" Width="270" MinWidth="130"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="150"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="HierarchyPane" Grid.Column="0" Background="{StaticResource PanelBackground}">
                    <DockPanel>
                        <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                            <Grid>
                                <TextBlock Text="Hierarchy" Style="{StaticResource PanelTitle}"/>
                                <Button Style="{StaticResource PanelTabCloseButton}" HorizontalAlignment="Right" Tag="hierarchy" Click="ClosePaneButton_Click"/>
                            </Grid>
                        </Border>
                        <TreeView x:Name="HierarchyTree" SelectedItemChanged="HierarchyTree_SelectedItemChanged"/>
                    </DockPanel>
                </Border>
                <GridSplitter Grid.Column="1" Width="5" Background="#111111" ResizeDirection="Columns" DragCompleted="LayoutSplitter_DragCompleted"/>
                <Border x:Name="InspectorPane" Grid.Column="2" Background="{StaticResource PanelBackground}">
                    <DockPanel>
                        <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                            <Grid>
                                <TextBlock Text="Inspector" Style="{StaticResource PanelTitle}"/>
                                <Button Style="{StaticResource PanelTabCloseButton}" HorizontalAlignment="Right" Tag="inspector" Click="ClosePaneButton_Click"/>
                            </Grid>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="InspectorPanel" Margin="10"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

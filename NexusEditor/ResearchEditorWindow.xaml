<Window x:Class="NexusEditor.ResearchEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Editor - Research" Width="1600" Height="960"
        MinWidth="1180" MinHeight="720" WindowState="Maximized"
        Background="#1e1e1e" Foreground="#dddddd"
        Icon="Assets/AppIcon.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#242424"/>
        <SolidColorBrush x:Key="ControlBackground" Color="#303030"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#454545"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4aa8ff"/>
        <SolidColorBrush x:Key="SelectedBrush" Color="#2f566f"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#dddddd"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#eeeeee"/>
            <Setter Property="Background" Value="#1d1d1d"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#376d92"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#eeeeee"/>
            <Setter Property="Background" Value="#383838"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                    <Setter Property="BorderBrush" Value="#666666"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.42"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#eeeeee"/>
            <Setter Property="Background" Value="#303030"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="#dddddd"/>
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#dddddd"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#343434"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2f566f"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="Foreground" Value="#dddddd"/>
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#dddddd"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#343434"/>
            <Setter Property="Foreground" Value="#dddddd"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#dddddd"/>
            <Setter Property="Background" Value="#343434"/>
            <Setter Property="Padding" Value="9,3"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="#dddddd"/>
            <Setter Property="Background" Value="#292929"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#2b2b2b"/>
            <Setter Property="BorderBrush" Value="#111111"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="PanelTitleTab" TargetType="Border">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Margin" Value="4,4,0,0"/>
            <Setter Property="Padding" Value="8,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#151515"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
        </Style>
        <Style x:Key="PanelHeaderIcon" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Foreground" Value="#a8a8a8"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="PanelHeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#dedede"/>
        </Style>
        <Style x:Key="PanelTabCloseButton" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="MinHeight" Value="16"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="Close panel"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#b8b8b8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <Grid Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M 3,3 L 9,9 M 9,3 L 3,9" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4a4a4a"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#686868"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#252525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarTrackButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UnityScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbChrome" Background="#5b5b5b" BorderBrush="#6b6b6b"
                                BorderThickness="1" CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#6f6f6f"/>
                                <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="#808080"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#7d7d7d"/>
                                <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="#9a9a9a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="VerticalUnityScrollBar" TargetType="{x:Type ScrollBar}">
            <Grid Width="18" Background="#2a2a2a">
                <Border Background="#303030" BorderBrush="#1a1a1a" BorderThickness="1"/>
                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                       ViewportSize="{TemplateBinding ViewportSize}" Margin="3,2">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollBarTrackButton}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource UnityScrollThumb}" MinHeight="34"/></Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollBarTrackButton}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="HorizontalUnityScrollBar" TargetType="{x:Type ScrollBar}">
            <Grid Height="18" Background="#2a2a2a">
                <Border Background="#303030" BorderBrush="#1a1a1a" BorderThickness="1"/>
                <Track x:Name="PART_Track" Orientation="Horizontal"
                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                       ViewportSize="{TemplateBinding ViewportSize}" Margin="2,3">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource ScrollBarTrackButton}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource UnityScrollThumb}" MinWidth="34"/></Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource ScrollBarTrackButton}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#2a2a2a"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Template" Value="{StaticResource VerticalUnityScrollBar}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="18"/>
                    <Setter Property="Template" Value="{StaticResource HorizontalUnityScrollBar}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="Background" Value="#303030"/>
            <Setter Property="BorderBrush" Value="#505050"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#315b75"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#5faee3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#4a4a4a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="22"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Height="22" VerticalAlignment="Top">
            <MenuItem Header="Preference" Click="PreferenceMenuItem_Click"/>
            <MenuItem Header="Window">
                <MenuItem Header="Event Editor" Click="EventEditorMenuItem_Click"/>
                <MenuItem Header="Research Editor" IsCheckable="True" IsChecked="True" IsEnabled="False"/>
                <Separator/>
                <MenuItem x:Name="CategoryPaneMenuItem" Header="Category List" IsCheckable="True" IsChecked="True" Tag="category" Click="PaneMenuItem_Click"/>
                <MenuItem x:Name="ScenePaneMenuItem" Header="Scene" IsCheckable="True" IsChecked="True" Tag="scene" Click="PaneMenuItem_Click"/>
                <MenuItem x:Name="HierarchyPaneMenuItem" Header="Hierarchy" IsCheckable="True" IsChecked="True" Tag="hierarchy" Click="PaneMenuItem_Click"/>
                <MenuItem x:Name="InspectorPaneMenuItem" Header="Inspector" IsCheckable="True" IsChecked="True" Tag="inspector" Click="PaneMenuItem_Click"/>
                <MenuItem x:Name="ConsolePaneMenuItem" Header="Console" IsCheckable="True" IsChecked="True" Tag="console" Click="PaneMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem Header="Validate Research" Click="ValidateMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="#292929" BorderBrush="#111111" BorderThickness="0,0,0,1">
            <Grid Margin="7,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Reload" Margin="0,0,5,0" Click="ReloadButton_Click"/>
                <Button Grid.Column="1" Content="Fit All" Margin="0,0,5,0" Click="FitAllButton_Click"/>
                <Button Grid.Column="2" Content="Export Preview" Click="ExportPreviewButton_Click"/>
                <ScrollViewer Grid.Column="4" MaxWidth="520"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PermissionFilterPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Permission" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="#aaaaaa"/>
                        <RadioButton x:Name="PermissionAll" GroupName="Permission" Content="All" Style="{StaticResource FilterToggle}"
                                     IsChecked="True" Tag="0" Checked="PermissionFilter_Checked"/>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock x:Name="WorkbookPathText" Grid.Column="5" Margin="14,0" VerticalAlignment="Center"
                           Foreground="#9e9e9e" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DirtyText" Grid.Column="6" VerticalAlignment="Center" Foreground="#f0c75e" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CategoryColumn" Width="250" MinWidth="170" MaxWidth="520"/>
                <ColumnDefinition x:Name="CategorySplitterColumn" Width="5"/>
                <ColumnDefinition x:Name="SceneColumn" Width="*" MinWidth="220"/>
                <ColumnDefinition x:Name="RightPaneSplitterColumn" Width="5"/>
                <ColumnDefinition x:Name="RightColumn" Width="700" MinWidth="520" MaxWidth="1500"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="CategoryPane" Grid.Column="0" Background="{StaticResource PanelBackground}">
                <DockPanel>
                    <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                        <DockPanel LastChildFill="False">
                            <Border DockPanel.Dock="Left" Style="{StaticResource PanelTitleTab}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▤" Style="{StaticResource PanelHeaderIcon}"/>
                                    <TextBlock Text="Category List" Style="{StaticResource PanelHeaderText}"/>
                                    <Button Style="{StaticResource PanelTabCloseButton}" Tag="category" Click="ClosePaneButton_Click"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Margin="8">
                        <TextBox x:Name="CategorySearchBox" Height="28" Margin="0,0,0,7" TextChanged="CategorySearchBox_TextChanged" ToolTip="Search category"/>
                        <Button Content="Add Category" Click="AddCategoryButton_Click"/>
                    </StackPanel>
                    <ListBox x:Name="CategoryList" SelectionChanged="CategoryList_SelectionChanged" PreviewMouseRightButtonDown="CategoryList_PreviewMouseRightButtonDown"/>
                </DockPanel>
            </Border>
            <GridSplitter x:Name="CategorySplitter" Grid.Column="1" Width="5" Background="#111111" ShowsPreview="False"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="SizeWE"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          DragCompleted="LayoutSplitter_DragCompleted"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="180"/>
                    <RowDefinition x:Name="ConsoleSplitterRow" Height="7"/>
                    <RowDefinition x:Name="ConsoleRow" Height="200" MinHeight="130"/>
                </Grid.RowDefinitions>
                <Border x:Name="ScenePane" Grid.Row="0" Background="#191919" BorderBrush="#111111" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                            <DockPanel LastChildFill="False">
                                <TextBlock x:Name="SceneStatusText" DockPanel.Dock="Right" Margin="8,0,8,0"
                                           VerticalAlignment="Center" Foreground="#9e9e9e"/>
                                <Border DockPanel.Dock="Left" Style="{StaticResource PanelTitleTab}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="#" Style="{StaticResource PanelHeaderIcon}"/>
                                        <TextBlock Text="Scene" Style="{StaticResource PanelHeaderText}"/>
                                        <Button Style="{StaticResource PanelTabCloseButton}" Tag="scene" Click="ClosePaneButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                        <Grid x:Name="SceneViewport" ClipToBounds="True" Focusable="True"
                              MouseWheel="SceneViewport_MouseWheel"
                              MouseRightButtonDown="SceneViewport_MouseRightButtonDown"
                              MouseRightButtonUp="SceneViewport_MouseRightButtonUp"
                              MouseMove="SceneViewport_MouseMove"
                              MouseLeftButtonDown="SceneViewport_MouseLeftButtonDown"
                              MouseLeftButtonUp="SceneViewport_MouseLeftButtonUp">
                            <Grid.Background><SolidColorBrush Color="#1a1a1a"/></Grid.Background>
                            <Canvas x:Name="GraphCanvas" Width="28000" Height="760" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="GraphScale" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="GraphTranslate"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>
                                <Canvas x:Name="BandCanvas" Width="28000" Height="760"/>
                                <Canvas x:Name="LinkCanvas" Width="28000" Height="760"/>
                                <Canvas x:Name="NodeCanvas" Width="28000" Height="760"/>
                                <Rectangle x:Name="StepSelectionMarquee" Visibility="Collapsed" IsHitTestVisible="False"
                                           Stroke="#52aad3" StrokeThickness="1.5" StrokeDashArray="4,2"
                                           Fill="#2852aad3" Panel.ZIndex="100"/>
                            </Canvas>
                            <Popup x:Name="QuickNodePopup"
                                   AllowsTransparency="True"
                                   Focusable="True"
                                   Placement="Right"
                                   StaysOpen="True">
                                <Border Width="310"
                                        Margin="10"
                                        Padding="11"
                                        Background="#2a2a2a"
                                        BorderBrush="#d6b94f"
                                        BorderThickness="1.5"
                                        CornerRadius="4">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="빠른 노드 편집" FontSize="14" FontWeight="SemiBold" Foreground="#f1d56a"/>
                                                <TextBlock x:Name="QuickNodeIdText" Margin="0,2,0,0" Foreground="#8bc8f1"
                                                           FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource PanelTabCloseButton}"
                                                    ToolTip="닫기" Click="QuickNodeCloseButton_Click"/>
                                        </Grid>

                                        <TextBlock Text="image" Foreground="#bdbdbd" Margin="0,0,0,3"/>
                                        <TextBox x:Name="QuickNodeImageBox" Margin="0,0,0,8"/>
                                        <TextBlock Text="active_item_id" Foreground="#bdbdbd" Margin="0,0,0,3"/>
                                        <TextBox x:Name="QuickNodeActiveItemBox" Margin="0,0,0,8"/>
                                        <TextBlock Text="active_item_value" Foreground="#bdbdbd" Margin="0,0,0,3"/>
                                        <TextBox x:Name="QuickNodeActiveValueBox" Margin="0,0,0,8"/>
                                        <TextBlock Text="active_step" Foreground="#bdbdbd" Margin="0,0,0,3"/>
                                        <TextBox x:Name="QuickNodeActiveStepBox" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="QuickNodeTotalText" Foreground="#999999" Margin="0,0,0,8"/>
                                        <Button Content="적용" Height="30" Click="QuickNodeApplyButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </DockPanel>
                </Border>
                <GridSplitter x:Name="ConsoleSplitter" Grid.Row="1" Height="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="#505050" Cursor="SizeNS" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              ShowsPreview="False" DragCompleted="LayoutSplitter_DragCompleted"/>
                <Border x:Name="ConsolePane" Grid.Row="2" Background="#202020">
                    <DockPanel>
                        <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Style="{StaticResource PanelTitleTab}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="!" Style="{StaticResource PanelHeaderIcon}"/>
                                        <TextBlock Text="Console / Validation" Style="{StaticResource PanelHeaderText}"/>
                                        <Button Style="{StaticResource PanelTabCloseButton}" Tag="console" Click="ClosePaneButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                        <DockPanel DockPanel.Dock="Top" Height="32" Background="#292929">
                            <Button Content="Clear" Width="58" Height="24" Margin="7,4" Click="ClearConsoleButton_Click"/>
                            <TextBox x:Name="ConsoleSearchBox" Height="24" Margin="4" TextChanged="ConsoleSearchBox_TextChanged"/>
                        </DockPanel>
                        <ListBox x:Name="ConsoleList" MouseDoubleClick="ConsoleList_MouseDoubleClick"/>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter x:Name="RightPaneSplitter" Grid.Column="3" Width="5" Background="#111111" ShowsPreview="False"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="SizeWE"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          DragCompleted="LayoutSplitter_DragCompleted"/>
            <Grid x:Name="RightPane" Grid.Column="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavigatorColumn" Width="0" MinWidth="0"/>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition x:Name="HierarchyColumn" Width="270" MinWidth="140" MaxWidth="720"/>
                    <ColumnDefinition x:Name="HierarchyInspectorSplitterColumn" Width="5"/>
                    <ColumnDefinition x:Name="InspectorColumn" Width="*" MinWidth="120"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="NavigatorPane" Grid.Column="0" Background="{StaticResource PanelBackground}" Visibility="Collapsed">
                    <DockPanel>
                        <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Style="{StaticResource PanelTitleTab}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⌖" Style="{StaticResource PanelHeaderIcon}"/>
                                        <TextBlock Text="Navigator" Style="{StaticResource PanelHeaderText}"/>
                                        <Button Style="{StaticResource PanelTabCloseButton}" Tag="navigator" Click="ClosePaneButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="NavigatorPanel" Margin="10"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <GridSplitter x:Name="NavigatorSplitter" Grid.Column="1" Width="5" Background="#111111" ResizeDirection="Columns"
                              Visibility="Collapsed" DragCompleted="LayoutSplitter_DragCompleted"/>
                <Border x:Name="HierarchyPane" Grid.Column="2" Background="{StaticResource PanelBackground}">
                    <DockPanel>
                        <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Style="{StaticResource PanelTitleTab}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="☷" Style="{StaticResource PanelHeaderIcon}"/>
                                        <TextBlock Text="Hierarchy" Style="{StaticResource PanelHeaderText}"/>
                                        <Button Style="{StaticResource PanelTabCloseButton}" Tag="hierarchy" Click="ClosePaneButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                        <TreeView x:Name="HierarchyTree" SelectedItemChanged="HierarchyTree_SelectedItemChanged"/>
                    </DockPanel>
                </Border>
                <GridSplitter x:Name="HierarchyInspectorSplitter" Grid.Column="3" Width="5" Background="#111111" ShowsPreview="False"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="SizeWE"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              DragCompleted="LayoutSplitter_DragCompleted"/>
                <Border x:Name="InspectorPane" Grid.Column="4" Background="{StaticResource PanelBackground}">
                    <DockPanel>
                        <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Style="{StaticResource PanelTitleTab}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="i" Style="{StaticResource PanelHeaderIcon}"/>
                                        <TextBlock Text="Inspector" Style="{StaticResource PanelHeaderText}"/>
                                        <Button Style="{StaticResource PanelTabCloseButton}" Tag="inspector" Click="ClosePaneButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="InspectorPanel" Margin="10"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

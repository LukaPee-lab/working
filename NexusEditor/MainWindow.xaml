<Window x:Class="NexusEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nexus Editor" Height="920" Width="1540"
        Icon="Assets/AppIcon.ico"
        Background="#1b1b1b" Foreground="#d8d8d8"
        WindowState="Maximized"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#3a3a3a"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#565656"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4a4a4a"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6a6a6a"/>
                                <Setter Property="Foreground" Value="#f1f1f1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#303030"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#2a2a2a"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#383838"/>
                                <Setter Property="Foreground" Value="#777777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderCloseButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="MinHeight" Value="18"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Content" Value="x"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="Close panel"/>
            <Setter Property="Background" Value="#343434"/>
            <Setter Property="Foreground" Value="#d8d8d8"/>
            <Setter Property="BorderBrush" Value="#4f4f4f"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       LineHeight="10"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#454545"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#686868"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#252525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelTabCloseButton" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="MinHeight" Value="16"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Content" Value="x"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="Close panel"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#b8b8b8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid Width="12"
                                  Height="12"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Path Data="M 3,3 L 9,9 M 9,3 L 3,9"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      SnapsToDevicePixels="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4a4a4a"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#686868"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#252525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RuntimeIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ConsoleFilterToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="#303030"/>
            <Setter Property="Foreground" Value="#d8d8d8"/>
            <Setter Property="BorderBrush" Value="#4c4c4c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3f3f3f"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#454545"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#7a7a7a"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#252525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#2b2b2b"/>
            <Setter Property="BorderBrush" Value="#111111"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="PanelTitleTab" TargetType="Border">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Margin" Value="4,4,0,0"/>
            <Setter Property="Padding" Value="8,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#151515"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
        </Style>
        <Style x:Key="PanelHeaderIcon" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Foreground" Value="#a8a8a8"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="PanelHeaderText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#dedede"/>
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#343434"/>
            <Setter Property="Foreground" Value="#d8d8d8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#4a4a4a"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkSubMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="Foreground" Value="#d8d8d8"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#3a3a3a"
                                BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CheckMark"
                                           Text="✓"
                                           Grid.Column="0"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#75a7d8"
                                           FontWeight="Bold"/>
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#345f88"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#777777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="#343434"/>
            <Setter Property="Foreground" Value="#d8d8d8"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="TopChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#3a3a3a"
                                BorderThickness="0">
                            <Grid>
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                       PopupAnimation="None">
                                    <Border Background="#242424"
                                            BorderBrush="#565656"
                                            BorderThickness="1"
                                            Padding="2">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="TopChrome" Property="Background" Value="#345f88"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="TopChrome" Property="Background" Value="#345f88"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#1f1f1f"/>
            <Setter Property="BorderBrush" Value="#111111"/>
            <Setter Property="Foreground" Value="#d8d8d8"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#d8d8d8"/>
            <Setter Property="Background" Value="#2b2b2b"/>
            <Setter Property="BorderBrush" Value="#151515"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#3a3a3a"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#454545"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarTrackButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UnityScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbChrome"
                                Background="#5b5b5b"
                                BorderBrush="#6b6b6b"
                                BorderThickness="1"
                                CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#6f6f6f"/>
                                <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="#808080"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#7d7d7d"/>
                                <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="#9a9a9a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="VerticalUnityScrollBar" TargetType="{x:Type ScrollBar}">
            <Grid Width="18" Background="#2a2a2a">
                <Border Background="#303030" BorderBrush="#1a1a1a" BorderThickness="1"/>
                <Track x:Name="PART_Track"
                       Orientation="Vertical"
                       IsDirectionReversed="True"
                       Minimum="{TemplateBinding Minimum}"
                       Maximum="{TemplateBinding Maximum}"
                       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                       ViewportSize="{TemplateBinding ViewportSize}"
                       Margin="3,2">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollBarTrackButton}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource UnityScrollThumb}" MinHeight="34"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollBarTrackButton}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="HorizontalUnityScrollBar" TargetType="{x:Type ScrollBar}">
            <Grid Height="18" Background="#2a2a2a">
                <Border Background="#303030" BorderBrush="#1a1a1a" BorderThickness="1"/>
                <Track x:Name="PART_Track"
                       Orientation="Horizontal"
                       Minimum="{TemplateBinding Minimum}"
                       Maximum="{TemplateBinding Maximum}"
                       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                       ViewportSize="{TemplateBinding ViewportSize}"
                       Margin="2,3">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource ScrollBarTrackButton}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource UnityScrollThumb}" MinWidth="34"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource ScrollBarTrackButton}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#2a2a2a"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Template" Value="{StaticResource VerticalUnityScrollBar}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="18"/>
                    <Setter Property="Template" Value="{StaticResource HorizontalUnityScrollBar}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2b2b2b"/>
            <Setter Property="Foreground" Value="#d8d8d8"/>
            <Setter Property="BorderBrush" Value="#4a4a4a"/>
            <Setter Property="CaretBrush" Value="#ffffff"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#111111" BorderThickness="0,0,0,1" Background="#252525">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="22" Background="#343434" BorderBrush="#202020" BorderThickness="0,0,0,1">
                    <Menu Height="21" Background="#343434">
                        <MenuItem x:Name="PreferenceMenuItem" Header="Preference" Style="{StaticResource TopMenuItem}" Click="PreferenceMenuItem_Click"/>
                        <MenuItem Header="Window" Style="{StaticResource TopMenuItem}">
                            <MenuItem Header="Event Editor" Style="{StaticResource DarkSubMenuItem}" IsCheckable="True" IsChecked="True" IsEnabled="False"/>
                            <MenuItem Header="Research Editor" Style="{StaticResource DarkSubMenuItem}" Click="ResearchEditorMenuItem_Click"/>
                            <Separator/>
                            <MenuItem x:Name="EventListMenuItem" Header="Event List" Style="{StaticResource DarkSubMenuItem}" IsCheckable="True" IsChecked="True" Tag="eventList" Click="WindowPaneMenuItem_Click"/>
                            <MenuItem x:Name="SceneMenuItem" Header="Scene" Style="{StaticResource DarkSubMenuItem}" IsCheckable="True" IsChecked="True" Tag="scene" Click="WindowPaneMenuItem_Click"/>
                            <MenuItem x:Name="HierarchyMenuItem" Header="Hierarchy" Style="{StaticResource DarkSubMenuItem}" IsCheckable="True" IsChecked="True" Tag="hierarchy" Click="WindowPaneMenuItem_Click"/>
                            <MenuItem x:Name="InspectorMenuItem" Header="Inspector" Style="{StaticResource DarkSubMenuItem}" IsCheckable="True" IsChecked="True" Tag="inspector" Click="WindowPaneMenuItem_Click"/>
                            <MenuItem x:Name="ConsoleMenuItem" Header="Console" Style="{StaticResource DarkSubMenuItem}" IsCheckable="True" IsChecked="True" Tag="console" Click="WindowPaneMenuItem_Click"/>
                            <Separator/>
                            <MenuItem Header="Reset Layout" Style="{StaticResource DarkSubMenuItem}" Click="ResetLayoutMenuItem_Click"/>
                        </MenuItem>
                        <MenuItem Header="Tools" Style="{StaticResource TopMenuItem}">
                            <MenuItem Header="Event info" Style="{StaticResource DarkSubMenuItem}" Click="EventInfoMenuItem_Click"/>
                        </MenuItem>
                    </Menu>
                </Border>
                <Grid Margin="8,3">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Panel.ZIndex="1">
                        <Button x:Name="ReloadButton" Content="Reload" Width="76" Click="ReloadButton_Click"/>
                        <Button x:Name="AutoLayoutButton" Width="112" Height="40" Padding="4,0" ToolTip="Auto Layout (Ctrl+Shift+L)" Click="AutoLayoutButton_Click">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Auto Layout" HorizontalAlignment="Center" FontSize="11" LineHeight="14"/>
                                <TextBlock Text="Ctrl+Shift+L" HorizontalAlignment="Center" FontSize="8.5" LineHeight="12" Foreground="#a9a9a9"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AutoLayoutAllButton" Width="124" Height="40" Padding="4,0" ToolTip="All Events Auto Layout" Click="AutoLayoutAllButton_Click">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Auto Layout" HorizontalAlignment="Center" FontSize="11" LineHeight="14"/>
                                <TextBlock Text="All Events" HorizontalAlignment="Center" FontSize="8.5" LineHeight="12" Foreground="#a9a9a9"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PreviewButton" Width="142" Height="40" Padding="4,0" ToolTip="Export Preview (Ctrl+Shift+E)" Click="PreviewButton_Click">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Export Preview" HorizontalAlignment="Center" FontSize="11" LineHeight="14"/>
                                <TextBlock Text="Ctrl+Shift+E" HorizontalAlignment="Center" FontSize="8.5" LineHeight="12" Foreground="#a9a9a9"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border x:Name="RuntimeRemote"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#303030"
                            BorderBrush="#151515"
                            BorderThickness="1"
                            Panel.ZIndex="5">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PlayButton" Content="▶" Style="{StaticResource RuntimeIconButton}" ToolTip="실행 대상 선택" Click="PlayButton_Click"/>
                            <Button x:Name="PauseButton" Content="❚❚" Style="{StaticResource RuntimeIconButton}" IsEnabled="False" ToolTip="Pause/Resume player" Click="PauseButton_Click"/>
                            <Button x:Name="StopButton" Content="■" Style="{StaticResource RuntimeIconButton}" IsEnabled="False" ToolTip="Stop player" Click="StopButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>

        <Grid x:Name="EditorSurface" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WorkPaneColumn" Width="*"/>
                <ColumnDefinition x:Name="RightPaneSplitterColumn" Width="5"/>
                <ColumnDefinition x:Name="RightPaneColumn" Width="640" MinWidth="260" MaxWidth="1500"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="WorkArea" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="ConsoleSplitterRow" Height="8"/>
                    <RowDefinition x:Name="ConsoleRow" Height="150" MinHeight="72" MaxHeight="760"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftPaneColumn" Width="250"/>
                        <ColumnDefinition x:Name="LeftPaneSplitterColumn" Width="5"/>
                        <ColumnDefinition x:Name="ScenePaneColumn" Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="EventListPane" Grid.Column="0" BorderBrush="#111111" BorderThickness="0,0,1,0" Background="#242424">
                        <DockPanel>
                            <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                                <DockPanel LastChildFill="False">
                                    <Border DockPanel.Dock="Left" Style="{StaticResource PanelTitleTab}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource PanelHeaderIcon}" Text="▤"/>
                                            <TextBlock Style="{StaticResource PanelHeaderText}" Text="Event List"/>
                                            <Button Style="{StaticResource PanelTabCloseButton}" Tag="eventList" Click="ClosePaneButton_Click"/>
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                            </Border>
                            <StackPanel DockPanel.Dock="Top" Margin="10">
                                <TextBox x:Name="SearchBox" Height="30" Margin="0,0,0,8" TextChanged="SearchBox_TextChanged"/>
                                <Button Content="Add Event" Height="32" Click="AddEventButton_Click"/>
                            </StackPanel>
                            <ListBox x:Name="EventList" SelectionChanged="EventList_SelectionChanged"
                                     Background="#1f1f1f" Foreground="#d8d8d8" BorderBrush="#111111"
                                     Margin="10,0,10,10"/>
                        </DockPanel>
                    </Border>

                    <GridSplitter x:Name="EventSceneSplitter" Grid.Column="1" Width="5" Background="#111111" ShowsPreview="False"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Cursor="SizeWE"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                  DragCompleted="LayoutSplitter_DragCompleted"/>

                    <Border x:Name="ScenePane" Grid.Column="2" BorderBrush="#111111" BorderThickness="0,0,1,0" Background="#1b1b1b">
                        <DockPanel>
                            <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                                <DockPanel LastChildFill="False">
                                    <TextBlock x:Name="SceneStatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="#a9a9a9" Text="Wheel: Zoom / RMB: Pan / RMB Click: Add"/>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource PanelTitleTab}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource PanelHeaderIcon}" Text="#"/>
                                            <TextBlock Style="{StaticResource PanelHeaderText}" Text="Scene"/>
                                            <Button Style="{StaticResource PanelTabCloseButton}" Tag="scene" Click="ClosePaneButton_Click"/>
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                            </Border>
                            <ScrollViewer x:Name="GraphScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          Background="#1b1b1b">
                                <Canvas x:Name="GraphCanvas" Width="12000" Height="8000" Margin="0"
                                        MouseLeftButtonDown="GraphCanvas_MouseLeftButtonDown"
                                        MouseMove="GraphCanvas_MouseMove"
                                        MouseLeftButtonUp="GraphCanvas_MouseLeftButtonUp"
                                        MouseRightButtonDown="GraphCanvas_MouseRightButtonDown"
                                        MouseRightButtonUp="GraphCanvas_MouseRightButtonUp"
                                        MouseWheel="GraphCanvas_MouseWheel">
                                    <Canvas.Background>
                                        <DrawingBrush TileMode="Tile" Viewport="0,0,160,160" ViewportUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <GeometryDrawing Brush="#1b1b1b">
                                                        <GeometryDrawing.Geometry>
                                                            <RectangleGeometry Rect="0,0,160,160"/>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                    <GeometryDrawing Geometry="M 32,0 L 32,160 M 64,0 L 64,160 M 96,0 L 96,160 M 128,0 L 128,160 M 0,32 L 160,32 M 0,64 L 160,64 M 0,96 L 160,96 M 0,128 L 160,128">
                                                        <GeometryDrawing.Pen>
                                                            <Pen Brush="#292929" Thickness="1"/>
                                                        </GeometryDrawing.Pen>
                                                    </GeometryDrawing>
                                                    <GeometryDrawing Geometry="M 160,0 L 160,160 M 0,160 L 160,160">
                                                        <GeometryDrawing.Pen>
                                                            <Pen Brush="#383838" Thickness="1.4"/>
                                                        </GeometryDrawing.Pen>
                                                    </GeometryDrawing>
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Canvas.Background>
                                </Canvas>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <GridSplitter x:Name="ConsoleSplitter" Grid.Row="1" Height="8" Background="#3a3a3a" ShowsPreview="True"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Cursor="SizeNS"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              DragCompleted="LayoutSplitter_DragCompleted"/>

                <Border x:Name="ConsolePane" Grid.Row="2" BorderBrush="#111111" BorderThickness="0,1,0,0" Background="#202020">
                    <DockPanel>
                        <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Style="{StaticResource PanelTitleTab}" MinWidth="132">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource PanelHeaderIcon}" Text="!"/>
                                        <TextBlock Style="{StaticResource PanelHeaderText}" Text="Console / Validation"/>
                                        <Button Style="{StaticResource PanelTabCloseButton}" Tag="console" Click="ClosePaneButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                        <DockPanel DockPanel.Dock="Top" Height="34" Background="#2a2a2a" LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="8,4">
                                <Button Content="Clear" Width="58" Height="24" MinHeight="24" Padding="8,0" Click="ConsoleClearButton_Click"/>
                                <TextBlock Text="Collapse" Foreground="#bdbdbd" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,5,6,5">
                                <ToggleButton x:Name="ConsoleErrorToggle" Style="{StaticResource ConsoleFilterToggle}" IsChecked="True"
                                              ToolTip="Errors" Click="ConsoleFilterToggle_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="!" Foreground="#ff684d" FontWeight="Bold" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="ConsoleErrorCount" Text="0" Foreground="#d8d8d8"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="ConsoleWarningToggle" Style="{StaticResource ConsoleFilterToggle}" IsChecked="True"
                                              ToolTip="Warnings" Click="ConsoleFilterToggle_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="!" Foreground="#ffc83d" FontWeight="Bold" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="ConsoleWarningCount" Text="0" Foreground="#d8d8d8"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="ConsoleInfoToggle" Style="{StaticResource ConsoleFilterToggle}" IsChecked="True"
                                              ToolTip="Info logs" Click="ConsoleFilterToggle_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="i" Foreground="#d8d8d8" FontWeight="Bold" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="ConsoleNotiCount" Text="0" Foreground="#d8d8d8"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                            <TextBox x:Name="ConsoleSearchBox" Height="24" Margin="8,5" TextChanged="ConsoleSearchBox_TextChanged"
                                     ToolTip="Console search"/>
                        </DockPanel>
                        <ListBox x:Name="ConsoleList"
                                 Margin="8,0,8,8"
                                 Background="#1f1f1f"
                                 Foreground="#d8d8d8"
                                 BorderBrush="#111111"/>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter x:Name="RightPaneSplitter" Grid.Column="1" Width="5" Background="#111111" ShowsPreview="False"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Cursor="SizeWE"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          DragCompleted="LayoutSplitter_DragCompleted"/>

            <Grid x:Name="RightDockArea" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HierarchyPaneColumn" Width="270" MinWidth="140" MaxWidth="720"/>
                    <ColumnDefinition x:Name="HierarchyInspectorSplitterColumn" Width="5"/>
                    <ColumnDefinition x:Name="InspectorPaneColumn" Width="*" MinWidth="120"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="HierarchyPane" Grid.Column="0" BorderBrush="#111111" BorderThickness="0,0,1,0" Background="#242424">
                    <DockPanel>
                        <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Style="{StaticResource PanelTitleTab}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource PanelHeaderIcon}" Text="▾"/>
                                        <TextBlock Style="{StaticResource PanelHeaderText}" Text="Hierarchy"/>
                                        <Button Style="{StaticResource PanelTabCloseButton}" Tag="hierarchy" Click="ClosePaneButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                        <Button DockPanel.Dock="Top" Content="Add Scene" Height="32" Margin="10" Click="AddGroupButton_Click"/>
                        <TreeView x:Name="HierarchyTree" SelectedItemChanged="HierarchyTree_SelectedItemChanged"
                                  Background="#1f1f1f" Foreground="#d8d8d8" BorderBrush="#111111"
                                  Margin="10,0,10,10"/>
                    </DockPanel>
                </Border>

                <GridSplitter x:Name="HierarchyInspectorSplitter" Grid.Column="1" Width="5" Background="#111111" ShowsPreview="False"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Cursor="SizeWE"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              DragCompleted="LayoutSplitter_DragCompleted"/>

                <Border x:Name="InspectorPane" Grid.Column="2" BorderBrush="#111111" BorderThickness="1,0,0,0" Background="#242424">
                    <Grid>
                        <DockPanel>
                            <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                                <DockPanel LastChildFill="False">
                                    <Border DockPanel.Dock="Left" Style="{StaticResource PanelTitleTab}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource PanelHeaderIcon}" Text="◈"/>
                                            <TextBlock Style="{StaticResource PanelHeaderText}" Text="Inspector"/>
                                            <Button Style="{StaticResource PanelTabCloseButton}" Tag="inspector" Click="ClosePaneButton_Click"/>
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                            </Border>
                            <Border x:Name="InspectorPreviewHost"
                                    DockPanel.Dock="Bottom"
                                    Margin="12,0,12,12"
                                    Visibility="Collapsed"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,12,12,6">
                                <StackPanel x:Name="InspectorPanel">
                                    <TextBlock Text="No Selection" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <TextBlock Text="Select an event or node on the left." Foreground="#a9a9a9"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                        <Border x:Name="InspectorAttentionOverlay"
                                Background="#184AA3FF"
                                BorderBrush="#78BDFF"
                                BorderThickness="2"
                                IsHitTestVisible="False"
                                Opacity="0"
                                Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

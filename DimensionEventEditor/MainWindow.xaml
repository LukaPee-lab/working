<Window x:Class="DimensionEventEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dimension Exploration Event Editor" Height="920" Width="1540"
        Background="#1b1b1b" Foreground="#d8d8d8"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#3a3a3a"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#565656"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4a4a4a"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6a6a6a"/>
                                <Setter Property="Foreground" Value="#f1f1f1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#303030"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#2a2a2a"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#383838"/>
                                <Setter Property="Foreground" Value="#777777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#2b2b2b"/>
            <Setter Property="BorderBrush" Value="#111111"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="PanelHeaderText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#dedede"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#1f1f1f"/>
            <Setter Property="BorderBrush" Value="#111111"/>
            <Setter Property="Foreground" Value="#d8d8d8"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#d8d8d8"/>
            <Setter Property="Background" Value="#2b2b2b"/>
            <Setter Property="BorderBrush" Value="#151515"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#3a3a3a"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#454545"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2b2b2b"/>
            <Setter Property="Foreground" Value="#d8d8d8"/>
            <Setter Property="BorderBrush" Value="#4a4a4a"/>
            <Setter Property="CaretBrush" Value="#ffffff"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition x:Name="ConsoleRow" Height="150" MinHeight="72" MaxHeight="760"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#111111" BorderThickness="0,0,0,1" Background="#252525">
            <DockPanel Margin="8,7">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="OpenButton" Content="Open DB" Width="82" Click="OpenButton_Click"/>
                    <Button x:Name="ReloadButton" Content="Reload" Width="76" Click="ReloadButton_Click"/>
                    <Border x:Name="RuntimeRemote" Background="#303030" BorderBrush="#151515" BorderThickness="1" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PlayButton" Content="▶" Width="38" Margin="0" ToolTip="선택 이벤트 재생/종료" Click="PlayButton_Click"/>
                            <Button x:Name="PauseButton" Content="Ⅱ" Width="38" Margin="0" IsEnabled="False" ToolTip="플레이어 일시정지/재개" Click="PauseButton_Click"/>
                            <Button x:Name="StopButton" Content="■" Width="38" Margin="0" IsEnabled="False" ToolTip="플레이어 종료" Click="StopButton_Click"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="AutoLayoutButton" Content="Auto Layout" Width="100" Click="AutoLayoutButton_Click"/>
                    <Button x:Name="PreviewButton" Content="Export Preview" Width="130" Click="PreviewButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="PathText" VerticalAlignment="Center" Foreground="#a9a9a9" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid x:Name="EditorSurface" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaneColumn" Width="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition x:Name="RightPaneColumn" Width="640" MinWidth="520" MaxWidth="1500"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#111111" BorderThickness="0,0,1,0" Background="#242424">
                <DockPanel>
                    <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource PanelHeaderText}" Text="Event List"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Margin="10">
                        <TextBox x:Name="SearchBox" Height="30" Margin="0,0,0,8" TextChanged="SearchBox_TextChanged"/>
                        <Button Content="신규 이벤트" Height="32" Click="AddEventButton_Click"/>
                    </StackPanel>
                    <ListBox x:Name="EventList" SelectionChanged="EventList_SelectionChanged"
                             Background="#1f1f1f" Foreground="#d8d8d8" BorderBrush="#111111"
                             Margin="10,0,10,10"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" Background="#111111" ShowsPreview="False"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Cursor="SizeWE"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          DragCompleted="LayoutSplitter_DragCompleted"/>

            <Border Grid.Column="2" BorderBrush="#111111" BorderThickness="0,0,1,0" Background="#1b1b1b">
                <DockPanel>
                    <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                        <DockPanel>
                            <TextBlock Style="{StaticResource PanelHeaderText}" Text="Scene"/>
                            <TextBlock x:Name="SceneStatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="#a9a9a9" Text="Wheel: Zoom / RMB: Pan / RMB Click: Add"/>
                        </DockPanel>
                    </Border>
                    <ScrollViewer x:Name="GraphScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                  Background="#1b1b1b">
                        <Canvas x:Name="GraphCanvas" Width="12000" Height="8000" Margin="0"
                                MouseLeftButtonDown="GraphCanvas_MouseLeftButtonDown"
                                MouseMove="GraphCanvas_MouseMove"
                                MouseLeftButtonUp="GraphCanvas_MouseLeftButtonUp"
                                MouseRightButtonDown="GraphCanvas_MouseRightButtonDown"
                                MouseRightButtonUp="GraphCanvas_MouseRightButtonUp"
                                MouseWheel="GraphCanvas_MouseWheel">
                            <Canvas.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,160,160" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#1b1b1b">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,160,160"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Geometry="M 32,0 L 32,160 M 64,0 L 64,160 M 96,0 L 96,160 M 128,0 L 128,160 M 0,32 L 160,32 M 0,64 L 160,64 M 0,96 L 160,96 M 0,128 L 160,128">
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#292929" Thickness="1"/>
                                                </GeometryDrawing.Pen>
                                            </GeometryDrawing>
                                            <GeometryDrawing Geometry="M 160,0 L 160,160 M 0,160 L 160,160">
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#383838" Thickness="1.4"/>
                                                </GeometryDrawing.Pen>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Canvas.Background>
                        </Canvas>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="5" Background="#111111" ShowsPreview="False"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Cursor="SizeWE"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          DragCompleted="LayoutSplitter_DragCompleted"/>

            <Grid Grid.Column="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HierarchyPaneColumn" Width="270" MinWidth="140" MaxWidth="720"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="240"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="#111111" BorderThickness="0,0,1,0" Background="#242424">
                    <DockPanel>
                        <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                            <TextBlock Style="{StaticResource PanelHeaderText}" Text="Hierarchy"/>
                        </Border>
                        <Button DockPanel.Dock="Top" Content="장면 추가" Height="32" Margin="10" Click="AddGroupButton_Click"/>
                        <TreeView x:Name="HierarchyTree" SelectedItemChanged="HierarchyTree_SelectedItemChanged"
                                  Background="#1f1f1f" Foreground="#d8d8d8" BorderBrush="#111111"
                                  Margin="10,0,10,10"/>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="5" Background="#111111" ShowsPreview="False"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Cursor="SizeWE"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              DragCompleted="LayoutSplitter_DragCompleted"/>

                <Border Grid.Column="2" BorderBrush="#111111" BorderThickness="1,0,0,0" Background="#242424">
                    <DockPanel>
                        <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                            <TextBlock Style="{StaticResource PanelHeaderText}" Text="Inspector"/>
                        </Border>
                        <Border x:Name="InspectorPreviewHost"
                                DockPanel.Dock="Bottom"
                                Margin="12,0,12,12"
                                Visibility="Collapsed"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,12,12,6">
                            <StackPanel x:Name="InspectorPanel">
                                <TextBlock Text="선택 없음" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
                                <TextBlock Text="왼쪽에서 이벤트 또는 노드를 선택하세요." Foreground="#a9a9a9"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="2" Height="8" Background="#3a3a3a" ShowsPreview="True"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Cursor="SizeNS"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      DragCompleted="LayoutSplitter_DragCompleted"/>

        <Border Grid.Row="3" BorderBrush="#111111" BorderThickness="0,1,0,0" Background="#202020">
            <DockPanel>
                <Border Style="{StaticResource PanelHeader}" DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource PanelHeaderText}" Text="Console / Validation"/>
                </Border>
                <DockPanel DockPanel.Dock="Top" Height="34" Background="#2a2a2a" LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="8,4">
                        <Button Content="Clear" Width="58" Click="ConsoleClearButton_Click"/>
                        <TextBlock Text="Collapse" Foreground="#bdbdbd" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,4">
                        <TextBlock x:Name="ConsoleNotiCount" Text="0" Foreground="#d8d8d8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="!" Foreground="#ffc83d" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock x:Name="ConsoleWarningCount" Text="0" Foreground="#d8d8d8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="!" Foreground="#ff684d" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock x:Name="ConsoleErrorCount" Text="0" Foreground="#d8d8d8" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox x:Name="ConsoleSearchBox" Height="24" Margin="8,5" TextChanged="ConsoleSearchBox_TextChanged"
                             ToolTip="Console search"/>
                </DockPanel>
                <TabControl x:Name="ConsoleTabs" Margin="8,0,8,8" Background="#1f1f1f" BorderBrush="#111111">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="!" Foreground="#ededed" FontWeight="Bold" Margin="0,0,5,0"/>
                                <TextBlock Text="Noti"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ListBox x:Name="NotiList" Background="#1f1f1f" Foreground="#d8d8d8" BorderBrush="#111111"/>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="!" Foreground="#ffc83d" FontWeight="Bold" Margin="0,0,5,0"/>
                                <TextBlock Text="Warning"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ListBox x:Name="WarningList" Background="#1f1f1f" Foreground="#d8d8d8" BorderBrush="#111111"/>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="!" Foreground="#ff5148" FontWeight="Bold" Margin="0,0,5,0"/>
                                <TextBlock Text="Error"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ListBox x:Name="ErrorList" Background="#1f1f1f" Foreground="#d8d8d8" BorderBrush="#111111"/>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
    </Grid>
</Window>
